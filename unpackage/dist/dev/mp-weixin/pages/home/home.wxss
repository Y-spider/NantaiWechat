.cloud.data-v-6832d226{
	-webkit-animation:cloud-move-data-v-6832d226 linear infinite;
	        animation:cloud-move-data-v-6832d226 linear infinite;
	-webkit-animation-duration: 30s;
	        animation-duration: 30s;
	-webkit-transform-origin: left;
	        transform-origin: left;
}
/* 定义关键帧 */
@-webkit-keyframes cloud-move-data-v-6832d226{
0%{
		-webkit-transform: translateX(0rpx);
		        transform: translateX(0rpx);
}
75%{
		-webkit-transform: translateX(160rpx);
		        transform: translateX(160rpx);
}
100%{
		-webkit-transform: translateX(0rpx);
		        transform: translateX(0rpx);
}
}
@keyframes cloud-move-data-v-6832d226{
0%{
		-webkit-transform: translateX(0rpx);
		        transform: translateX(0rpx);
}
75%{
		-webkit-transform: translateX(160rpx);
		        transform: translateX(160rpx);
}
100%{
		-webkit-transform: translateX(0rpx);
		        transform: translateX(0rpx);
}
