<block wx:if="{{isShow}}"><view class="data-v-424b4bac"><view class="pop-box data-v-424b4bac"><view class="line-box data-v-424b4bac"><label class="data-v-424b4bac">文件名称:</label><input placeholder="可以手动修改" data-event-opts="{{[['input',[['__set_model',['','fileName','$event',[]]]]]]}}" value="{{fileName}}" bindinput="__e" class="data-v-424b4bac"/></view><view class="line-box data-v-424b4bac"><label class="data-v-424b4bac">文件大小:</label><input disabled="{{true}}" value="{{showFileSize}}" class="data-v-424b4bac"/></view><view class="line-box data-v-424b4bac"><label class="data-v-424b4bac">上传进度:</label><progress percent="{{uploadProgress}}" show-info="{{true}}" stroke-width="3" class="data-v-424b4bac"></progress></view><view class="line-box data-v-424b4bac"><label class="data-v-424b4bac">上传图片:</label><uni-file-picker style="border:1rpx solid black;" vue-id="071d27c8-1" fileMediatype="image" file-extname="jpg,png,jpeg" mode="grid" limit="{{6}}" size-type="compress" auto-upload="false" image-styles="{{imgStyle}}" value="{{base64ImageList}}" data-event-opts="{{[['^select',[['select']]],['^sourceType',[['album']]],['^success',[['success']]],['^fail',[['fail']]],['^delete',[['deleteImg']]],['^input',[['__set_model',['','base64ImageList','$event',[]]]]]]}}" bind:select="__e" bind:sourceType="__e" bind:success="__e" bind:fail="__e" bind:delete="__e" bind:input="__e" class="data-v-424b4bac" bind:__l="__l"></uni-file-picker></view><view class="line-box data-v-424b4bac"><label class="data-v-424b4bac">选择文件:</label><button style="background-color:#ccc;margin-left:-60rpx;" size="mini" type="primary" data-event-opts="{{[['tap',[['getFileFormLocal']]]]}}" bindtap="__e" class="data-v-424b4bac">选择上传文件</button></view><view class="line-box data-v-424b4bac" style="display:flex;"><view style="height:100%;" class="data-v-424b4bac"><label class="data-v-424b4bac">文件描述:</label></view><textarea style="border:1rpx solid black;" maxlength="500" placeholder="500字以内" data-event-opts="{{[['input',[['__set_model',['','fileDes','$event',[]]]]]]}}" value="{{fileDes}}" bindinput="__e" class="data-v-424b4bac"></textarea></view><view style="margin:60rpx 0rpx;" class="data-v-424b4bac"><button type="primary" size="mini" data-event-opts="{{[['tap',[['uploadFile']]]]}}" bindtap="__e" class="data-v-424b4bac">上传</button></view></view></view></block>